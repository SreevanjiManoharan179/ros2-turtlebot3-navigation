<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tb3_point_to_point</name>
  <version>1.0.0</version>
  <description>
    Indoor point-to-point autonomous navigation for TurtleBot3 Burger (ROS 2 Humble with
    Gazebo Classic, ROS 2 Jazzy with Gazebo Sim; Nav2, SLAM Toolbox): custom indoor office world, autonomous mapping,
    named-room goal sender, evaluation runner with performance metrics and plots.
  </description>
  <maintainer email="bharathwajm.works@gmail.com">Bharathwaj Manoharan</maintainer>
  <author email="bharathwajm.works@gmail.com">Bharathwaj Manoharan</author>
  <license>Apache-2.0</license>

  <!-- runtime: Python nodes -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend condition="$ROS_DISTRO == humble">gazebo_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <!-- runtime: launch files -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend condition="$ROS_DISTRO == humble">gazebo_ros</exec_depend>
  <exec_depend condition="$ROS_DISTRO != humble">ros_gz_sim</exec_depend>
  <exec_depend condition="$ROS_DISTRO != humble">ros_gz_bridge</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
